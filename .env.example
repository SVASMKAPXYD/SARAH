# Copy to .env.local. Never prefix the Gemini key with NEXT_PUBLIC_ — it must stay server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# mock = never call Gemini (also automatic when GEMINI_API_KEY is empty). Remove/blank for live.
DECIDER=mock
# 1 = show the manual decision console (dev). Also available via ?dev=1.
NEXT_PUBLIC_DEV_CONSOLE=1

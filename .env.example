# Copy to .env.local. Never prefix the Gemini key with NEXT_PUBLIC_ — it must stay server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set to mock to force the mock decider; leave unset to use Gemini when GEMINI_API_KEY is set.
DECIDER=
# 1 = show the manual decision console in development only.
NEXT_PUBLIC_DEV_CONSOLE=
